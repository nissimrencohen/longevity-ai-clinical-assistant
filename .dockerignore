# Keep the build context small and the image reproducible.

.git/
.github/
.venv/
.claude/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Secrets never enter an image. Compose injects configuration as environment.
.env
librechat/.env

# Generated at build time inside the image (see Dockerfile); shipping the host's
# copy would defeat the point and bloat the context.
models/mlflow_risk_router/
mlruns/
mlartifacts/
mlflow.db

# Host-run artefacts
logs/
evals/results/

# Docs and local tooling
*.md
!README.md
Longevity_AI_Take_Home_Overview.docx
