# Copy to `.env` and adjust. Used by the FastAPI backend and the FastMCP server.
# (LibreChat has its OWN .env — see librechat/env.notes.md.)

# Shared bearer token for the MCP server. LibreChat's .env must set the SAME value
# so its Authorization: Bearer header is accepted. Change it for anything real.
MCP_BEARER_TOKEN=dev-longevity-token-change-me

# FastAPI backend base URL — the MCP server calls this.
BACKEND_URL=http://127.0.0.1:8001

# MLflow model server /invocations endpoint — the backend calls this.
MLFLOW_URL=http://127.0.0.1:5001/invocations

# MCP server bind. Must be 0.0.0.0 so LibreChat's Docker container can reach it
# via host.docker.internal.
#
# GUIDE.md pins this to 9000. We moved to 9100 because 9000 is a popular default
# (QuestDB, MinIO and ClickHouse all publish it) and a stray container holding it
# produces a confusing failure: the port is occupied, so "is something listening?"
# checks pass, but LibreChat talks to the wrong service and reports
# "Failed to initialize MCP server".
#
# If you change this, change it in THREE places or the wiring breaks:
#   1. here
#   2. librechat/librechat.yaml -> mcpServers.longevity-clinical.url
#   3. librechat/librechat.yaml -> mcpSettings.allowedAddresses
MCP_HOST=0.0.0.0
MCP_PORT=9100

# Path to the mock patient DB. The backend already defaults to <repo>/data/patient_db.db,
# so you normally don't need to set this. Uncomment to override.
# PATIENT_DB_PATH=data/patient_db.db

# --- OpenRouter key ----------------------------------------------------------
# NOT needed for the stack, for pytest, or for the Tier A evals. Those are all
# free and offline.
#
# Needed for: Tier B evals (`--tier b`), and the LibreChat chat UI.
#
# The eval harness looks for OPENROUTER_KEY in this order:
#   1. the OPENROUTER_KEY environment variable
#   2. this file
#   3. librechat/.env
#   4. ../LibreChat/.env
#
# So uncommenting the line below is enough to run Tier B. The CHAT UI reads a
# different file -- LibreChat's own .env in its checkout -- and needs the key
# there too. See librechat/env.notes.md.
# OPENROUTER_KEY=sk-or-...

# --- Access control (Phase 5) -----------------------------------------------
# "clinic_wide" is the assignment's model — every doctor sees every patient — and
# is the DEFAULT. Set to "care_team" to restrict each actor to the patients
# assigned to them in the care_team table.
RBAC_MODE=clinic_wide

# Every access decision, allowed or denied, is written to the audit log. Not
# conditional on restricting access: recording who looked at what is worth doing
# even when everyone may look at everything.
AUDIT_ENABLED=true

# The bearer token above authenticates AND identifies: it carries a physician
# role. Set any of these to hand out additional role-scoped tokens so the policy
# can actually be exercised. A caller cannot assert a role by asking for one —
# the role comes from the verified token, not from the request.
# MCP_ACTOR_ID=dr-cohen
# MCP_TOKEN_NURSE=dev-nurse-token-change-me
# MCP_TOKEN_RESEARCHER=dev-researcher-token-change-me
# MCP_TOKEN_AUDITOR=dev-auditor-token-change-me
